    "Capture One will export each photo with its adjustments and import it into the destination catalog, recreating groups and albums. Nothing is deleted from the source catalog.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One exportarà cada foto amb els seus ajustos i la importarà al catàleg de destinació, recreant grups i àlbums. No s'esborra res del catàleg d'origen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One exportará cada foto con sus ajustes y la importará en el catálogo de destino, recreando grupos y álbumes. No se borra nada del catálogo de origen."
          }
        }
      }
    },
    "Catalog": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Catàleg"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Catálogo"
          }
        }
      }
    },
    "Catalog format %lld is newer than the versions this app was tested with. Check the results.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El format de catàleg %lld és més nou que les versions amb què es va provar aquesta app. Revisa els resultats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato de catálogo %lld es más nuevo que las versiones con las que se probó esta app. Revisa los resultados."
          }
