          }
        }
      }
    },
    "Timed out waiting for Capture One: %@": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ha esgotat el temps d'espera amb Capture One: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de espera agotado con Capture One: %@"
          }
        }
      }
    },
    "Transfers the matching albums, with all adjustments, layers, masks and metadata, into another catalog using Capture One. Nothing is deleted from the source.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasllada els àlbums seleccionats, amb tots els ajustos, capes, màscares i metadades, a un altre catàleg fent servir Capture One. No s'esborra res de l'origen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traslada los álbumes seleccionados, con todos sus ajustes, capas, máscaras y metadatos, a otro catálogo usando Capture One. No se borra nada del origen."
