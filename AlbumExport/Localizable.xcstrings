            "value": "La otra copia ya no está en disco: se conserva"
          }
        }
      }
    },
    "They will be moved to %@ keeping their folder structure, so they can be imported again.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mouran a %@ conservant l'estructura de carpetes, per poder-los importar de nou."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se moverán a %@ conservando su estructura de carpetas, para poder importarlos de nuevo."
          }
        }
      }
    },
    "This catalog format is not supported. Missing: %@": {
      "localizations": {
        "ca": {
