    "Copies the originals of the matching albums to a folder and writes rating, color, keywords and IPTC into each file (XMP).": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia els originals dels àlbums seleccionats a una carpeta i escriu valoració, color, paraules clau i IPTC a cada fitxer (XMP)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia los originales de los álbumes seleccionados a una carpeta y escribe rating, color, keywords e IPTC en cada fichero (XMP)."
          }
        }
      }
    },
