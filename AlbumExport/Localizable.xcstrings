            "value": "Cancel·lada per l'usuari"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelada por el usuario"
          }
        }
      }
    },
    "Capture One %@, format %lld": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One %@, format %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One %@, formato %lld"
          }
        }
      }
    },
    "Capture One did not add %lld photos. Press the button again to retry.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One no ha afegit %lld fotos. Prem el botó una altra vegada per reintentar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One no ha añadido %lld fotos. Pulsa el botón otra vez para reintentar."
          }
        }
      }
    },
    "Capture One did not import or file %lld photos.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One no ha importat o classificat %lld fotos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One no ha importado o clasificado %lld fotos."
          }
        }
      }
    },
    "Capture One did not open the catalog %@.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One no ha obert el catàleg %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One no ha abierto el catálogo %@."
          }
        }
      }
    },
    "Capture One error: %@": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de Capture One: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de Capture One: %@"
          }
        }
      }
    },
    "Capture One has this catalog open and saves its changes to disk with a delay: photos you just deleted there can show up here as missing. Restoring, removing and moving files are disabled. Close the catalog in Capture One and press Verify again.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Capture One té obert aquest catàleg i desa els canvis al disc amb retard: les fotos que acabes d'esborrar allà poden sortir aquí com a perdudes. Restaurar, eliminar i moure fitxers està desactivat. Tanca el catàleg al Capture One i prem Verifica de nou."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One tiene abierto este catálogo y guarda sus cambios en disco con retraso: las fotos que acabas de borrar allí pueden salir aquí como perdidas. Restaurar, eliminar y mover ficheros está desactivado. Cierra el catálogo en Capture One y pulsa Verificar de nuevo."
          }
        }
      }
    },
    "Capture One is not installed.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One no està instal·lat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One no está instalado."
          }
        }
      }
    },
    "Capture One will export each photo with its adjustments and import it into the destination catalog, recreating groups and albums. Nothing is deleted from the source catalog.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One exportarà cada foto amb els seus ajustos i la importarà al catàleg de destinació, recreant grups i àlbums. No s'esborra res del catàleg d'origen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One exportará cada foto con sus ajustes y la importará en el catálogo de destino, recreando grupos y álbumes. No se borra nada del catálogo de origen."
          }
        }
      }
    },
    "Capture One will import a copy of each photo that is not in the catalog and file it in an album named after its probable album, or \"%@\". The orphan files themselves are not touched: after importing they become spare copies that you can move out. Copies of photos already in the catalog are not imported.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One importarà una còpia de cada foto que no és al catàleg i la posarà en un àlbum amb el nom del seu àlbum probable, o a \"%@\". Els fitxers orfes no es toquen: després d'importar passen a ser còpies sobrants que pots treure. Les còpies de fotos que ja són al catàleg no s'importen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One importará una copia de cada foto que no está en el catálogo y la pondrá en un álbum con el nombre de su álbum probable, o en \"%@\". Los ficheros huérfanos no se tocan: tras importar pasan a ser copias sobrantes que puedes sacar. Las copias de fotos que ya están en el catálogo no se importan."
          }
        }
      }
    },
    "Capture One will open the catalog and create that group with one album per probable album, \"%@\" for the rest and \"%@\" for repeated copies of photos already in an album. Nothing is removed or moved.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One obrirà el catàleg i crearà aquest grup amb un àlbum per cada àlbum probable, \"%1$@\" per a la resta i \"%2$@\" per a les còpies repetides de fotos que ja són en un àlbum. No s'esborra ni es mou res."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture One abrirá el catálogo y creará ese grupo con un álbum por cada álbum probable, \"%1$@\" para el resto y \"%2$@\" para las copias repetidas de fotos que ya están en un álbum. No se borra ni se mueve nada."
          }
        }
      }
    },
    "Catalog": {
      "localizations": {
        "ca": {
