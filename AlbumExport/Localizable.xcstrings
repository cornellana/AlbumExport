    "Not in any album: %lld (%lld duplicates)": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense àlbum: %lld (%lld duplicats)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin álbum: %lld (%lld duplicados)"
          }
        }
      }
    },
    "Not in any album: the photo is in the catalog and its file is fine, but it belongs to none of your albums (Recent Imports does not count). Usually photos you removed from an album while culling. Duplicates are repeated imports of a photo that is in an album.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense àlbum: la foto és al catàleg i el fitxer està bé, però no pertany a cap dels teus àlbums (Recent Imports no compta). Solen ser fotos que vas treure d'un àlbum en fer neteja. Els duplicats són importacions repetides d'una foto que sí que és en un àlbum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin álbum: la foto está en el catálogo y su fichero está bien, pero no pertenece a ninguno de tus álbumes (Recent Imports no cuenta). Suelen ser fotos que quitaste de un álbum al hacer limpieza. Los duplicados son importaciones repetidas de una foto que sí está en un álbum."
          }
        }
      }
    },
    "Not in the catalog": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No és al catàleg"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está en el catálogo"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "D'acord"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar"
          }
        }
      }
    },
    "Older catalog: effective metadata will be merged from adjustment and default layers.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Catàleg antic: les metadades efectives es fusionaran de les capes d'ajust i per defecte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Catálogo antiguo: los metadatos efectivos se fusionarán de las capas de ajuste y por defecto."
          }
        }
      }
    },
    "Only catalogs can be moved to another catalog, not sessions.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només es poden moure catàlegs a un altre catàleg, no sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden mover catálogos a otro catálogo, no sesiones."
          }
        }
      }
    },
    "Open Catalog…": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre el catàleg…"
          }
        },
        "es": {
