{
  "sourceLanguage": "en",
  "strings": {
    "%@ at %@": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en %@"
          }
        }
      }
    },
    "%@/s": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/s"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/s"
          }
        }
      }
    },
    "%lld files could not be removed (e.g. %@: %@)": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld fitxers no s'han pogut eliminar (p. ex. %2$@: %3$@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ficheros no se han podido eliminar (p. ej. %2$@: %3$@)"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld"
          }
        }
      }
    },
    "%lld photos already in %@: adding them to the album without re-importing.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fotos ja són a %@: s'afegeixen a l'àlbum sense tornar-les a importar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fotos ya están en %@: se añaden al álbum sin volver a importarlas."
          }
        }
      }
    },
    "%lld photos to copy, %@": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fotos per copiar, %@"
          }
        },
        "es": {
