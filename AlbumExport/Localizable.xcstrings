    "Catalog format %lld is newer than the versions this app was tested with. Check the results.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El format de catàleg %lld és més nou que les versions amb què es va provar aquesta app. Revisa els resultats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato de catálogo %lld es más nuevo que las versiones con las que se probó esta app. Revisa los resultados."
