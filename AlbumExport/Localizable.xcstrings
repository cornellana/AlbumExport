    "Another catalog entry with the same file name has its file. This missing entry is a duplicate import; remove it in Capture One.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una altra entrada del catàleg amb el mateix nom sí que té el fitxer. Aquesta entrada perduda és una importació duplicada; esborra-la al Capture One."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra entrada del catálogo con el mismo nombre sí tiene su fichero. Esta entrada perdida es una importación duplicada; bórrala en Capture One."
          }
        }
      }
    },
