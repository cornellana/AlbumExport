    "Compare the Originals folder with the catalog index and list orphan files": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la carpeta Originals amb l'índex del catàleg i llista els fitxers orfes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la carpeta Originals con el índice del catálogo y lista los ficheros huérfanos"
          }
        }
      }
    },
    "Compares the Originals folder with the index: orphan files, missing files and photos that belong to no album.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la carpeta Originals amb l'índex: fitxers orfes, fitxers absents i fotos que no són a cap àlbum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la carpeta Originals con el índice: ficheros huérfanos, ficheros ausentes y fotos que no están en ningún álbum."
          }
        }
      }
    },
    "Copied": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiada"
          }
        },
        "es": {
